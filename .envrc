source_url "https://raw.githubusercontent.com/cachix/devenv/95f329d49a8a5289d31e0982652f7058a189bfca/direnvrc" "sha256-d+8cBpDfDBj41inrADaJt+bDWhOktwslgoP5YiGJ1v0="

# Load local environment variables for AEAT Verifactu secrets (cert/key paths
# and the private key passphrase). Not tracked in git; see .env.local.
if [ -f .env.local ]; then
  dotenv .env.local
fi
watch_file .env.local

use devenv